# ── Server-side (Vercel serverless functions) ────────────────────────────────
# Used only by the /api functions. NEVER prefix with VITE_ and never reference
# it in vite.config.ts — either would embed the key in the public bundle.
# Locally: put it in .env and run `vercel dev`. In production: set it in the
# Vercel dashboard (Project → Settings → Environment Variables).
ANTHROPIC_API_KEY="sk-ant-..."

# ── Client-side (embedded in the bundle by design) ───────────────────────────
# Google Maps JavaScript API key for the pantry/event maps. This key ships to
# the browser, so restrict it by HTTP referrer in the Google Cloud console.
# On Vercel it must be set as a build-time environment variable.
VITE_GOOGLE_MAPS_API_KEY="AIza..."

# Sort the Shift game backend (sortshift-backend/, deployed separately with
# CDK — the ApiUrl stack output). Leave unset to run the game in practice mode
# (no leaderboard). Build-time variable, embedded in the bundle by design.
VITE_SORTSHIFT_API_URL="https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com"

# ── Seed script only (npm run seed) ───────────────────────────────────────────
# Path to a Firebase service-account JSON (Firebase console → Project settings
# → Service accounts → Generate new private key). Required because Firestore
# rules only allow admins/pantry staff to write pantries and events.
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
